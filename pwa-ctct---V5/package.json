{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:auth": "node scripts/app-auth.test.mjs",
    "test:repositories": "node scripts/supabase-business.test.mjs",
    "test:responsive": "node scripts/responsive-mobile-lock.test.mjs",
    "migrate:cds:questions:dry-run": "node scripts/import-cds-questions.mjs --source ../cds/data/questions.json",
    "users:seed": "node scripts/create-demo-users.mjs",
    "test:security:live": "node scripts/live-security.test.mjs",
    "test:rls:live": "node scripts/live-rls.test.mjs",
    "test:migration:staging": "node scripts/staging-migration.test.mjs",
    "test:migration:reconcile": "node scripts/staging-reconciliation.test.mjs",
    "demo:rc1:seed": "node scripts/demo-rc1-seed.mjs",
    "demo:rc1:smoke": "node scripts/demo-rc1-smoke.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
